# Локальный запуск. Для production задайте сильные секреты и DOCFLOW_ENVIRONMENT=production.
DOCFLOW_ENVIRONMENT=development
DOCFLOW_API_KEY=dev-only-change-me
POSTGRES_PASSWORD=docflow_dev_only
DOCFLOW_DATABASE_URL=postgresql+asyncpg://docflow:docflow_dev_only@localhost:5432/docflow

# Внешние провайдеры. LLM и embeddings должны поддерживать OpenAI-совместимый API.
# Значения ниже подходят для Docker Compose; для локального Python замените host.docker.internal на localhost.
DOCFLOW_OCR_URL=http://localhost:8001/predict
DOCFLOW_LLM_BASE_URL=http://host.docker.internal:11434/v1
DOCFLOW_LLM_MODEL=qwen2.5:14b
DOCFLOW_LLM_API_KEY=
DOCFLOW_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
DOCFLOW_EMBEDDING_MODEL=bge-m3
DOCFLOW_EMBEDDING_API_KEY=

DOCFLOW_MAX_UPLOAD_BYTES=20971520
DOCFLOW_MAX_PDF_PAGES=100
DOCFLOW_WORKER_LEASE_SECONDS=300
DOCFLOW_WORKER_HEARTBEAT_SECONDS=30
DOCFLOW_LOG_LEVEL=INFO
